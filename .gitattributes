# Store text as LF in the repository.
* text=auto eol=lf
*.java       text eol=lf
*.xml        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
*.properties text eol=lf
*.json       text eol=lf
*.sh         text eol=lf
*.bat        text eol=crlf
*.cmd        text eol=crlf

*.jar binary
*.png binary
*.zip binary
