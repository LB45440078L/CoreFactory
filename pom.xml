<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.moretntplus</groupId>
  <artifactId>MoreTNTPlus</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>MoreTNTPlus (parent)</name>
  <description>New TNT mechanics, items, crafting and textures for Spigot 1.21.11 and 26.x.</description>
  <url>https://github.com/LB45440078L/MoreTNTPlus</url>

  <modules>
    <module>MoreTNTPlus-Api</module>
    <module>MoreTNTPlus-Core</module>
    <module>MoreTNTPlus-Spigot</module>
    <module>MoreTNTPlus-ResourcePack</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <!-- Compile target. Override with one of the api-* profiles below, e.g. -Papi-1.21.11 -->
    <spigot.api.version>26.1-R0.1-SNAPSHOT</spigot.api.version>
    <worldedit.version>7.4.6</worldedit.version>
    <worldguard.version>7.0.20</worldguard.version>
    <packetevents.version>2.14.0</packetevents.version>
    <snakeyaml.version>2.4</snakeyaml.version>

    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>

    <compiler.plugin.version>3.16.0</compiler.plugin.version>
    <surefire.plugin.version>3.6.0</surefire.plugin.version>
    <exec.plugin.version>3.5.0</exec.plugin.version>
    <shade.plugin.version>3.6.0</shade.plugin.version>
  </properties>

  <profiles>
    <!-- Default: compile against Spigot-API 26.1. Every profile builds the same sources. -->
    <profile>
      <id>api-26.1</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <properties><spigot.api.version>26.1-R0.1-SNAPSHOT</spigot.api.version></properties>
    </profile>
    <profile>
      <id>api-26.2</id>
      <properties><spigot.api.version>26.2-R0.1-SNAPSHOT</spigot.api.version></properties>
    </profile>
    <profile>
      <id>api-26.3</id>
      <properties><spigot.api.version>26.3-R0.1-SNAPSHOT</spigot.api.version></properties>
    </profile>
    <profile>
      <id>api-1.21.11</id>
      <properties><spigot.api.version>1.21.11-R0.1-SNAPSHOT</spigot.api.version></properties>
    </profile>
  </profiles>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- Server platform: never shaded, always provided by the server. -->
      <dependency>
        <groupId>org.spigotmc</groupId>
        <artifactId>spigot-api</artifactId>
        <version>${spigot.api.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- Hard dependency A: WorldEdit or FastAsyncWorldEdit. FAWE implements the same
           com.sk89q.worldedit API, so one compile-time binding serves both. -->
      <dependency>
        <groupId>com.sk89q.worldedit</groupId>
        <artifactId>worldedit-bukkit</artifactId>
        <version>${worldedit.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- Optional integration: WorldGuard, used through its API only when the plugin is present. -->
      <dependency>
        <groupId>com.sk89q.worldguard</groupId>
        <artifactId>worldguard-bukkit</artifactId>
        <version>${worldguard.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- Hard dependency B: PacketEvents runs as its own plugin (plugin.yml depend: [packetevents]). -->
      <dependency>
        <groupId>com.github.retrooper</groupId>
        <artifactId>packetevents-spigot</artifactId>
        <version>${packetevents.version}</version>
        <scope>provided</scope>
      </dependency>

      <dependency>
        <groupId>io.moretntplus</groupId>
        <artifactId>MoreTNTPlus-Api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.moretntplus</groupId>
        <artifactId>MoreTNTPlus-Core</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- Build-time only: the resource pack generator reads tnts.yml and items.yml. -->
      <dependency>
        <groupId>org.yaml</groupId>
        <artifactId>snakeyaml</artifactId>
        <version>${snakeyaml.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <repository>
      <id>spigotmc-snapshots</id>
      <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
      <snapshots><enabled>true</enabled></snapshots>
      <releases><enabled>false</enabled></releases>
    </repository>
    <repository>
      <id>enginehub</id>
      <url>https://maven.enginehub.org/repo/</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
    <repository>
      <id>codemc-releases</id>
      <url>https://repo.codemc.io/repository/maven-releases/</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
            <compilerArgs>
              <arg>-Xlint:all</arg>
              <arg>-Xlint:-processing</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
